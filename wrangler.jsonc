{
  // Cloudflare Worker for nategrimwood.com: /fiddle (the tune book) and /planning (editor only)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tunebook",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tunebook",
      "database_id": "69e4b5da-7aa7-499a-807e-5f53f32e5bed"
    }
  ],
  // Routes (not custom domains) so the existing proxied DNS records for @ and www can stay as they are.
  "routes": [
    { "pattern": "nategrimwood.com/*", "zone_name": "nategrimwood.com" },
    { "pattern": "www.nategrimwood.com/*", "zone_name": "nategrimwood.com" }
  ],
  "vars": {
    // Public OAuth client ID for "Sign in with Google" (Google Cloud project "Tune Book"). Not a secret.
    "GOOGLE_CLIENT_ID": "108966496545-2n8acck4q1hi0bqb0mvqq6hldllj3ce5.apps.googleusercontent.com",
    // Google accounts allowed to edit, comma-separated. Everyone else gets the public view.
    "EDITOR_EMAILS": "nate.cole.owen@gmail.com",
    // Invited viewers, comma-separated: they sign in with Google and read everything the editor can (private notes,
    // personal links, hearings, Drive recordings) but cannot change anything. Remove an email here to end its access.
    "VIEWER_EMAILS": "johnswatson.music@gmail.com,connollymp17@gmail.com,stern.hayden.e@gmail.com",
    // Google Drive "Fiddle" folder. Recordings are read through the service account in the GOOGLE_SERVICE_ACCOUNT secret.
    "DRIVE_FOLDER_ID": "14zVG4SsfHgLwdI_B6VkhAsy8I-YJSrzd",
    // Only this repo's nightly workflow (.github/workflows/video-audio.yml) may use the /job/ endpoints.
    "GITHUB_REPO": "newOnahtaN/tunebook",
    // Public half of the key Nate's PC signs /planning publishes with (POST /planning/publish in src/worker.js).
    // Not a secret. The private half lives only in that PC's Windows key store (CNG key "nategrimwood-planning-publisher").
    "PLANNING_PUBLISH_KEY": "{\"kty\":\"RSA\",\"n\":\"uHB_9ioJWyOGiRHD0nj-XTL9AGboWSnoV4qA0kwa6kwYIzVasbS4NK5eIPcmaZVLNXrG68ZtYY9HNVPSUa_O_Mr9pKEgZ2EChCiio59owVtLEyz9QXFndOzbW-2GlqX8BNswT8dMnQgsJ7JMKOJuVS55x8RB8M7qy4JjC_jUyTh0RIkZcPAt0uztMRlmnIDdhPEKQqM4TjH-fHc1KDgOMr1ifMbvg9eW_sss13eAHeFE39wmWD716nMw5qKobfyNgQQsnnpZ5D8gPIA_jnDvtAw1isU7vX-7TkZjmdKkySEbWKScMwJ_awwWBByYVN9_5umOUKUpH2c8tBRkar5tg4vTUCMUDBf204qhXoZzskXaGqlZUTbzngVAGM3cZwXdLrUvQ7IV77QCDMZxkCB_H8WNK22A9ucUSthpZRjJTaDzK2Lqkj7_If0h0iM7Z_LOe3QabMzaIcwguMomW_x4t3FT5jZting_OiuH3fcB4fomJhDAj5tsbn7OeFu53g9h\",\"e\":\"AQAB\"}"
  },
  // Rescan Drive once a day (11:17 UTC, early morning in Seattle).
  "triggers": { "crons": ["17 11 * * *"] },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
